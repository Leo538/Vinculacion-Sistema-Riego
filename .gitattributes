# Auto detect text files and normalize line endings to LF
* text=auto

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf
backend/mvnw text eol=lf

# Windows batch files
*.cmd text eol=crlf
*.bat text eol=crlf
backend/mvnw.cmd text eol=crlf

# Text files
*.md text eol=lf
*.txt text eol=lf
*.properties text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.gradle text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Binary files
*.jar binary
*.class binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.zip binary
*.tar binary
*.gz binary
